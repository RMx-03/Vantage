# ============================================================
# Vantage Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Backend API URL (local dev only; in production the Vercel rewrite proxies /api to Heroku)
VITE_API_URL=http://localhost:8000

# Research workbench UI (off by default; the backend needs RESEARCH_WORKBENCH_ENABLED=true too)
VITE_RESEARCH_WORKBENCH_ENABLED=false
