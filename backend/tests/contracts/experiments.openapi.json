  "openapi": "3.1.0",
  "paths": {
    "/api/v1/experiments": {
      "get": {
        "description": "The owner's experiments, newest first, as summaries.",
        "operationId": "list_experiments_api_v1_experiments_get",
        "parameters": [
          {
