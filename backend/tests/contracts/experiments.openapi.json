          "candidates": {
            "items": {
              "discriminator": {
                "mapping": {
                  "buy_and_hold": "#/components/schemas/BuyAndHoldParams",
                  "momentum_top_k": "#/components/schemas/MomentumTopKParams",
                  "sma_crossover": "#/components/schemas/SmaCrossoverParams"
