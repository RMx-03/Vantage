# ============================================================
# Vantage Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

# Application display name (informational only)
APP_NAME=Vantage

# Semver string shown in /docs and health-check response
APP_VERSION=0.1.0

# Immutable revision of the deployed artifact (Git SHA or image/build digest).
# Recorded as the code version of every research run and reported as the
# Langfuse release. CI injects the commit SHA; leave as "development" locally.
CODE_REVISION=development

# URL prefix for all v1 API routes
API_V1_PREFIX=/api/v1

# Calendar-day lookback applied to company news relative to the analysis cutoff.
NEWS_LOOKBACK_DAYS=7

# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Comma-separated JSON list of frontend origins allowed to call the API.
# Vite dev server default is 5173; CRA default is 3000.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Ollama — Local LLM Server (Phase 3)
# ------------------------------------------------------------

# Base URL of the running Ollama instance.
# Use http://localhost:11434 for local dev.
# Use http://ollama:11434 when running inside Docker Compose.
OLLAMA_BASE_URL=http://localhost:11434

# Name of the model loaded in Ollama.
# Set to the alias you created when importing the .gguf file.
# Example: ollama create vantage-fin -f ./Modelfile
OLLAMA_MODEL=vantage-fin

# ------------------------------------------------------------
# Multi-Provider Cloud LLMs (Phase 3 Architecture Shift)
# ------------------------------------------------------------

# The active LLM engine. Valid options: "disabled", "ollama", "gemini", "groq".
# Disabled runs deterministic research without calling a model.
LLM_PROVIDER=ollama

# Timeout in seconds per model request for every enabled provider.
LLM_TIMEOUT_SECONDS=30

# Additional Vantage-owned attempts for transient failures (SDK retries disabled).
LLM_MAX_RETRIES=1

# Google Gemini Configuration (Requires LLM_PROVIDER=gemini)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration (Requires LLM_PROVIDER=groq)
# Get a key from: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# Supabase Authentication
# ------------------------------------------------------------

# Project URL from Supabase dashboard (Settings -> API)
SUPABASE_URL=

# anon public key from Supabase dashboard (Settings -> API)
SUPABASE_KEY=

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------

# Development-only sample credentials for a locally running PostgreSQL
# instance (e.g. the one docker-compose.yml exposes on 5433). Never reuse
# these values in a deployed environment; supply real ones from a managed
# secret store. When running the full stack via `docker compose`, the
# runtime and owner passwords are instead supplied by POSTGRES_RUNTIME_PASSWORD
# and POSTGRES_OWNER_PASSWORD in the repository root's .env (see .env.example
# there); this DATABASE_URL is for running the backend directly against a
# database you manage yourself.

# Runtime application database connection (psycopg3 driver)
DATABASE_URL=postgresql+psycopg://vantage_runtime:vantage_runtime@localhost:5433/vantage_test

# Migration / DDL owner connection (psycopg3 driver)
MIGRATION_DATABASE_URL=postgresql+psycopg://vantage_owner:vantage_owner@localhost:5433/vantage_test

# Existing PostgreSQL role that receives only runtime DML grants during migration.
VANTAGE_RUNTIME_DB_ROLE=vantage_runtime

# ------------------------------------------------------------
# Telemetry and Observability (Phase 1 Task 8)
# ------------------------------------------------------------

# Enable external trace export to Langfuse (default false for local/CI)
TRACE_EXPORT_ENABLED=false

# Secret salt for pseudonymous user hash calculation
TELEMETRY_USER_SALT=vantage-telemetry-salt

# Langfuse Configuration (Requires TRACE_EXPORT_ENABLED=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Timeout in seconds for the OTLP HTTP export request to Langfuse
LANGFUSE_TIMEOUT_SECONDS=5
