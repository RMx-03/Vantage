# ============================================================
# Vantage — Docker Compose Environment Variables
# Copy this file to .env in the repository root before running
# `docker compose up`. NEVER commit .env to version control.
#
# This file configures the development-oriented Compose stack only.
# Every value below is a clearly-marked development placeholder, not a
# production credential. Deployed environments must supply real secrets
# from a managed secret store and use a managed or private database —
# do not deploy this Compose file as-is.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

# Password for the migration/DDL owner role (vantage_owner). Development
# default only; the role can create and alter schema objects.
POSTGRES_OWNER_PASSWORD=vantage_owner

# Password for the least-privilege runtime application role
# (vantage_runtime), bootstrapped by backend/docker/postgres/init-runtime-role.sh.
# Development default only; this role has no schema/DDL privileges.
# Interpolated unencoded into a postgresql+psycopg:// URI in docker-compose.yml,
# so avoid reserved URI characters here: @ : / % #
POSTGRES_RUNTIME_PASSWORD=vantage_runtime

# ------------------------------------------------------------
# Supabase Authentication
# ------------------------------------------------------------

# Project URL from Supabase dashboard (Settings -> API). The Compose
# default is a non-secret placeholder that lets containers start without
# real authentication.
SUPABASE_URL=https://example.supabase.co

# anon public key from Supabase dashboard (Settings -> API)
SUPABASE_KEY=local-development-anon-key

# ------------------------------------------------------------
# Telemetry and Observability
# ------------------------------------------------------------

# Enable external trace export to Langfuse (default false for local use)
TRACE_EXPORT_ENABLED=false

# Secret salt for pseudonymous user hash calculation
TELEMETRY_USER_SALT=local-development-only

# Immutable build identity (Git SHA or image digest) reported as versions.code
# and used as the Langfuse release. CI supplies the commit SHA.
CODE_REVISION=development

# Langfuse Configuration (Requires TRACE_EXPORT_ENABLED=true)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ------------------------------------------------------------
# Multi-Provider Cloud LLMs
# ------------------------------------------------------------

# The active LLM engine. Valid options: "disabled", "ollama", "gemini", "groq".
# Disabled by default: no model runs unless an operator opts in. The
# `local` profile (docker compose --profile local up) starts Ollama but
# does not select it automatically — set LLM_PROVIDER=ollama explicitly.
LLM_PROVIDER=disabled

# Google Gemini Configuration (Requires LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# Groq Configuration (Requires LLM_PROVIDER=groq)
GROQ_API_KEY=

# ------------------------------------------------------------
# Frontend
# ------------------------------------------------------------

# Base URL the frontend build uses to reach the backend API.
VITE_API_URL=http://localhost:8000
